#!/usr/bin/env sage
from parameters import p, p_bits, f, cofactor, fp_bytes, ref_radix

def emit_macro(name, value):
    print(f"#define {name} {value}", file=header)

def initializer(value, radix, words):
    mask = (1 << radix) - 1
    return "{ " + ", ".join(hex((value >> (radix * i)) & mask) for i in range(words)) + " }"

def emit_montgomery(radix):
    words = (p_bits + radix - 1) // radix
    R = 1 << (radix * words)
    emit_macro("NWORDS_FIELD", words)
    emit_macro("FP_LIMB_RADIX", radix)
    emit_macro("FP_MONT_ONE", initializer(R % p, radix, words))
    emit_macro("FP_MONT_TWO_INV", initializer((R * inverse_mod(2, p)) % p, radix, words))
    emit_macro("FP_MONT_THREE_INV", initializer((R * inverse_mod(3, p)) % p, radix, words))
    return words, R

with open("include/fp_constants.h", "w") as header:
    print("/* Generated by precompute_field_constants.sage. */", file=header)
    print("#ifndef FP_CONSTANTS_H\n#define FP_CONSTANTS_H\n", file=header)
    emit_macro("FP_FIELD_BITS", p_bits)
    emit_macro("FP_COFACTOR", f"{cofactor}ULL")
    emit_macro("FP_TORSION_POWER", f)
    emit_macro("BITS", fp_bytes * 8)
    emit_macro("NWORDS_ORDER", "(BITS / RADIX)")
    print("\n#if defined(SQISIGN_GF_IMPL_BROADWELL)", file=header)
    print('#if RADIX != 64\n#error "Broadwell requires a 64-bit radix"\n#endif', file=header)
    words, R = emit_montgomery(64)
    emit_macro("FP_MODULUS_INIT", initializer(p, 64, words))
    emit_macro("FP_TWICE_MODULUS_INIT", initializer(2 * p, 64, words))
    emit_macro("FP_MONT_R2", initializer(R**2 % p, 64, words))
    for word_size in (64, 32):
        print(f"#elif RADIX == {word_size}", file=header)
        emit_montgomery(ref_radix[word_size])
    print('#else\n#error "Unsupported field radix"\n#endif\n\n#endif', file=header)
